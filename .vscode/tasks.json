{
  "version": "2.0.0",
  "options": {},
  "presentation": {
    "reveal": "silent",
    "revealProblems": "onProblem"
  },
  "tasks": [
    {
      "label": "build",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": [
        "build: docs",
        "Office Macros: compile (debug)",
        "Office Macros: compile (release)",
        "Office Scripts: compile"
      ]
    },
    {
      "label": "build: docs",
      "type": "shell",
      "command": "powershell.exe",
      "args": ["-NoLogo", "-NoProfile", "-File", "Docs.ps1"],
      "problemMatcher": [],
      "hide": true
    },
    {
      "label": "Office Macros: compile (debug)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "Compile.OfficeMacros.ps1"
      ],
      "problemMatcher": [],
      "hide": true
    },
    {
      "label": "Office Macros: compile (release)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "Compile.OfficeMacros.ps1",
        "-Release"
      ],
      "problemMatcher": [],
      "hide": true
    },
    {
      "label": "Office Scripts: compile",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "Compile.OfficeScripts.ps1"
      ],
      "problemMatcher": [],
      "hide": true
    },
    {
      "label": "Office Macros: decompile (debug)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "Decompile.OfficeMacros.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Office Macros: decompile (release)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "Decompile.OfficeMacros.ps1",
        "-Release"
      ],
      "problemMatcher": []
    },
    {
      "label": "Office Scripts: decompile",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "Decompile.OfficeScripts.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "pester",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/D",
        "/E:ON",
        "/V:OFF",
        "/S",
        "/C",
        "call",
        ".agents\\skills\\powershell-5\\scripts\\pester.cmd",
        "-Path",
        "${file}",
        "-LineNumber",
        "${lineNumber}"
      ],
      "problemMatcher": ["$pester"],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "psscriptanalyzer",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/D",
        "/E:ON",
        "/V:OFF",
        "/S",
        "/C",
        "call",
        ".agents\\skills\\powershell-5\\scripts\\analyze.cmd",
        "-Path",
        "${file}"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "test"
      }
    }
  ]
}
