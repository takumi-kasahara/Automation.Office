# git config --local include.path ../.gitconfig
[hook "lint"]
  event = pre-commit
  command = npm run lint && git update-index --again
[hook "test"]
  event = pre-commit
  command = npm test
[hook "parse-modules"]
  event = pre-commit
  command = .agents/skills/powershell-5/scripts/parse.cmd -Path ./Modules -Recurse
[hook "parse-scripts"]
  event = pre-commit
  command = .agents/skills/powershell-5/scripts/parse.cmd -Path ./Scripts -Recurse
[hook "analyze-modules"]
  event = pre-commit
  command = .agents/skills/powershell-5/scripts/analyze.cmd -Path ./Modules -Recurse && git update-index --again
[hook "analyze-scripts"]
  event = pre-commit
  command = .agents/skills/powershell-5/scripts/analyze.cmd -Path ./Scripts -Recurse && git update-index --again
[hook "pester"]
  event = pre-commit
  command = .agents/skills/powershell-5/scripts/pester.cmd -Path ./Modules/Sources -TagFilter CI
